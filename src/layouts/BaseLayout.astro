---
import '../styles/global.css';
import Sidebar from '../components/navigation/Sidebar.astro';
import MobileMenu from '../components/navigation/MobileMenu.tsx';
import SearchModal from '../components/widgets/SearchModal.tsx';
import Breadcrumbs from '../components/ui/Breadcrumbs.astro';
import Footer from '../components/Footer.astro';

export interface Props {
  title?: string;
  description?: string;
  currentPath?: string;
  userName?: string;
  userRole?: string;
}

// ─── valores por defecto para el layout
const {
  title = "Dashboard",
  description = "",
  currentPath = "/",
  userName = "Cristopher Pérez",
  userRole = "Analista Financiero"
} = Astro.props;

// ─── mapa de titulos por pagina
const pageTitles: Record<string, string> = {
  "/": "Dashboard",
  "/busqueda-historica/": "Filtrado de Datos",
  "/pronostico-mercado/": "Pronóstico de Mercado",
  "/api-info/": "API Info",
  "/dev-team/": "Dev Team",
};
const currentPageTitle = pageTitles[currentPath] || title;

// ─── mapa de descripciones por pagina
const pageDescriptions: Record<string, string> = {
  "/": "Dashboard financiero con indicadores económicos chilenos en tiempo real: UF, UTM, Dólar, Euro, IPC, IMACEC y más.",
  "/busqueda-historica/": "Consulta el valor histórico de indicadores financieros chilenos por año y tipo.",
  "/pronostico-mercado/": "Proyección de indicadores financieros basada en regresión lineal sobre datos históricos de mindicador.cl.",
  "/api-info/": "Documentación técnica de la API pública mindicador.cl para indicadores económicos chilenos.",
  "/dev-team/": "Conoce al equipo detrás de PYME Finance.",
};
const currentPageDescription = pageDescriptions[currentPath] || description;

// ─── generar iniciales del usuario
const userInitials = userName.split(" ").map((word) => word[0]).join("").slice(0, 2).toUpperCase();
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <title>{currentPageTitle} — PYME Finance</title>
    <meta name="description" content={currentPageDescription} />
    <meta property="og:title" content={`${currentPageTitle} — PYME Finance`} />
    <meta property="og:description" content={currentPageDescription} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body data-page={currentPath} class="min-h-screen bg-surface font-sans text-slate-100 antialiased">
    <div class="flex min-h-screen">
      <Sidebar currentPath={currentPath} />
      <div class="relative flex min-h-screen flex-1 flex-col lg:pl-60">
        <header class="sticky top-0 z-30 flex h-14 items-center gap-3 border-b border-slate-800/50 bg-surface/80 px-6 backdrop-blur-xl lg:px-8">
          <MobileMenu currentPath={currentPath} client:load />
          <Breadcrumbs currentPath={currentPath} />
          <div class="flex items-center gap-2.5 lg:hidden">
            <span class="h-5 w-0.5 rounded-full bg-slate-700" />
            <span class="text-sm font-bold tracking-tight text-white">PYME Finance</span>
          </div>
          <div class="ml-auto flex items-center gap-1.5">
            <SearchModal client:load />
            <span class="mx-1 h-5 w-px bg-slate-800" />
            <div class="flex items-center gap-2 pl-1">
              <div class="flex h-7 w-7 items-center justify-center rounded-full bg-gradient-to-br from-emerald-500 to-emerald-600 text-[11px] font-semibold text-white shadow-sm">
                {userInitials}
              </div>
              <div class="hidden text-xs leading-tight sm:block">
                <p class="font-medium text-slate-200">{userName}</p>
                <p class="text-slate-500">{userRole}</p>
              </div>
            </div>
          </div>
        </header>
        <main class="flex-1 px-6 py-8 lg:px-8">
          <slot />
        </main>
        <Footer />
      </div>
    </div>
  </body>
</html>
