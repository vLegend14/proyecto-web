---
import '../styles/global.css';
import Sidebar from '../components/navigation/Sidebar.astro';
import MobileMenu from '../components/navigation/MobileMenu.tsx';
import Footer from '../components/Footer.astro';

export interface Props {
  title?: string;
  currentPath?: string;
}

const { title = "Dashboard", currentPath = "/" } = Astro.props;

const pageTitles: Record<string, string> = {
  "/": "Dashboard",
  "/busqueda-historica/": "Búsqueda Histórica",
  "/pronostico-mercado/": "Pronóstico de Mercado",
  "/api-info/": "API Info",
  "/dev-team/": "Dev Team",
};
const currentTitle = pageTitles[currentPath] || title;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <title>{currentTitle} — PYME Finance</title>
  </head>
  <body class="min-h-screen bg-surface font-sans text-slate-100 antialiased">
    <div class="flex min-h-screen">
      <Sidebar currentPath={currentPath} />
      <div class="relative flex min-h-screen flex-1 flex-col lg:pl-64">
        <header class="sticky top-0 z-30 flex h-14 items-center gap-3 border-b border-slate-800/50 bg-surface/80 px-4 backdrop-blur-xl lg:px-7">
          <MobileMenu currentPath={currentPath} client:load />
          <div class="flex items-center gap-2.5">
            <span class="hidden h-6 w-0.5 rounded-full bg-slate-700 lg:block" />
            <div class="hidden items-center gap-2 lg:flex">
              <span class="text-sm font-semibold tracking-tight text-slate-100">{currentTitle}</span>
            </div>
          </div>
          <div class="lg:hidden">
            <span class="text-sm font-bold tracking-tight text-white">PYME Finance</span>
          </div>
          <div class="ml-auto flex items-center gap-1.5">
            <button class="relative flex h-8 w-8 items-center justify-center rounded-lg text-slate-500 transition-colors hover:bg-slate-800/60 hover:text-slate-300">
              <svg class="h-[18px] w-[18px]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
              </svg>
            </button>
            <button class="relative flex h-8 w-8 items-center justify-center rounded-lg text-slate-500 transition-colors hover:bg-slate-800/60 hover:text-slate-300">
              <svg class="h-[18px] w-[18px]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9" />
              </svg>
              <span class="absolute right-1.5 top-1.5 h-1.5 w-1.5 rounded-full bg-emerald-500" />
            </button>
            <span class="mx-1 h-5 w-px bg-slate-800" />
            <div class="flex items-center gap-2 pl-1">
              <div class="flex h-7 w-7 items-center justify-center rounded-full bg-gradient-to-br from-emerald-500 to-emerald-600 text-[11px] font-semibold text-white shadow-sm">
                U
              </div>
              <div class="hidden text-xs leading-tight sm:block">
                <p class="font-medium text-slate-200">Usuario</p>
                <p class="text-slate-500">Administrador</p>
              </div>
            </div>
          </div>
        </header>
        <main class="flex-1 px-4 py-6 lg:px-7">
          <slot />
        </main>
        <Footer />
      </div>
    </div>
  </body>
</html>
