---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Página no encontrada" currentPath="/">
  <div class="flex min-h-[60vh] flex-col items-center justify-center text-center">
    <div class="mb-6 flex h-20 w-20 items-center justify-center rounded-2xl bg-slate-800/40 ring-1 ring-slate-700/50">
      <svg class="h-10 w-10 text-slate-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126zM12 15.75h.007v.008H12v-.008z" />
      </svg>
    </div>
    <h1 class="text-3xl font-bold text-white sm:text-4xl">404</h1>
    <p class="mt-2 text-sm text-slate-500">Página no encontrada</p>
    <p class="mt-1 text-xs text-slate-600">La ruta que buscas no existe o ha sido movida.</p>
    <a href="/" class="mt-6 inline-flex items-center gap-2 rounded-lg bg-emerald-500/10 px-4 py-2.5 text-sm font-medium text-emerald-400 ring-1 ring-emerald-500/20 transition-all hover:bg-emerald-500/20 active:scale-95">
      <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 12l8.954-8.955c.44-.439 1.152-.439 1.591 0L21.75 12M4.5 9.75v10.125c0 .621.504 1.125 1.125 1.125H9.75v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21h4.125c.621 0 1.125-.504 1.125-1.125V9.75M8.25 21h5.25" />
      </svg>
      Volver al inicio
    </a>
  </div>
</BaseLayout>
