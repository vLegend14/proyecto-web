---
import BaseLayout from '../layouts/BaseLayout.astro';
import Card from '../components/ui/Card.astro';
import AreaChart from '../components/charts/AreaChart.tsx';
import StressScenarioCard from '../components/widgets/StressScenarioCard.astro';
---

<BaseLayout title="Pronóstico de Mercado" currentPath="/pronostico-mercado/">
  <div class="max-w-7xl">
    <div class="mb-8">
      <h2 class="text-2xl font-bold text-white">Pronóstico de Mercado</h2>
      <p class="mt-1 text-sm text-neutral-400">Proyección de indicadores financieros basada en datos históricos</p>
    </div>

    <Card class="mb-8">
      <div class="mb-4 flex items-center justify-between">
        <h3 class="text-base font-semibold text-white">Proyección UF — Próximos 12 meses</h3>
        <div class="flex items-center gap-4 text-xs text-neutral-500">
          <span class="flex items-center gap-1.5">
            <span class="h-2.5 w-2.5 rounded-full bg-emerald-500" />
            Histórico
          </span>
          <span class="flex items-center gap-1.5">
            <span class="h-2.5 w-2.5 rounded-full bg-amber-400" />
            Proyectado
          </span>
        </div>
      </div>
      <AreaChart client:load />
      <div class="mt-4 grid grid-cols-2 gap-4 border-t border-neutral-800 pt-4 text-sm sm:grid-cols-4">
        <div>
          <p class="text-neutral-500">Mínimo proyectado</p>
          <p class="font-semibold text-white">$51.000</p>
        </div>
        <div>
          <p class="text-neutral-500">Máximo proyectado</p>
          <p class="font-semibold text-white">$53.800</p>
        </div>
        <div>
          <p class="text-neutral-500">Variación esperada</p>
          <p class="font-semibold text-emerald-400">+7,8%</p>
        </div>
        <div>
          <p class="text-neutral-500">Confianza</p>
          <p class="font-semibold text-amber-400">Media-Alta</p>
        </div>
      </div>
    </Card>

    <div class="mb-6">
      <h3 class="mb-2 text-lg font-semibold text-white">Simulador de Escenarios de Estrés Económico</h3>
      <p class="mb-6 text-sm text-neutral-400">Evalúa el comportamiento de tus inversiones bajo diferentes condiciones de mercado.</p>

      <Card class="mb-6">
        <label for="amount" class="mb-1.5 block text-xs font-medium text-neutral-400">Monto en CLP</label>
        <div class="flex gap-3">
          <div class="relative flex-1">
            <span class="pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 text-sm text-neutral-500">$</span>
            <input
              type="text"
              id="amount"
              value="10.000.000"
              readonly
              class="w-full rounded-lg border border-neutral-700 bg-neutral-800 py-2.5 pl-7 pr-3 text-sm text-white outline-none focus:border-primary focus:ring-1 focus:ring-primary"
            />
          </div>
          <button class="rounded-lg bg-primary px-5 py-2.5 text-sm font-medium text-white transition-colors hover:bg-primary-dark">
            Simular
          </button>
        </div>
      </Card>

      <div class="grid grid-cols-1 gap-4 md:grid-cols-3">
        <StressScenarioCard
          title="Valor Proyectado"
          value="$10.850.000"
          change="+8,5% en 12 meses"
          description="Crecimiento sostenido con inflación controlada y estabilidad cambiaria. Escenario base con recuperación económica gradual."
          variant="optimistic"
        />
        <StressScenarioCard
          title="Valor Proyectado"
          value="$10.450.000"
          change="+4,5% en 12 meses"
          description="Mercado con volatilidad moderada. Crecimiento estable pero por debajo del promedio histórico reciente."
          variant="conservative"
        />
        <StressScenarioCard
          title="Valor Proyectado"
          value="$9.200.000"
          change="-8,0% en 12 meses"
          description="Escenario de contracción económica con alta inflación y depreciación cambiaria significativa."
          variant="risk"
        />
      </div>
    </div>
  </div>
</BaseLayout>
