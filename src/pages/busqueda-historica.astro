---
import BaseLayout from '../layouts/BaseLayout.astro';
import Card from '../components/ui/Card.astro';
import DataTable from '../components/ui/DataTable.astro';
---

<BaseLayout title="Búsqueda Histórica" currentPath="/busqueda-historica/">
  <div class="max-w-7xl">
    <div class="mb-8">
      <h2 class="text-2xl font-bold text-white">Búsqueda Histórica</h2>
      <p class="mt-1 text-sm text-neutral-400">Consulta el valor histórico de indicadores financieros</p>
    </div>

    <Card class="mb-8">
      <div class="flex flex-col gap-4 sm:flex-row sm:items-end">
        <div class="flex-1">
          <label for="currency" class="mb-1.5 block text-xs font-medium text-neutral-400">Indicador</label>
          <select id="currency" class="w-full rounded-lg border border-neutral-700 bg-neutral-800 px-3 py-2.5 text-sm text-white outline-none focus:border-primary focus:ring-1 focus:ring-primary">
            <option>Unidad de Fomento (UF)</option>
            <option>Unidad Tributaria Mensual (UTM)</option>
            <option>Dólar Observado (USD)</option>
            <option>Euro Comercial (EUR)</option>
            <option>Índice de Precios al Consumidor (IPC)</option>
          </select>
        </div>
        <div class="flex-1">
          <label for="year" class="mb-1.5 block text-xs font-medium text-neutral-400">Año</label>
          <select id="year" class="w-full rounded-lg border border-neutral-700 bg-neutral-800 px-3 py-2.5 text-sm text-white outline-none focus:border-primary focus:ring-1 focus:ring-primary">
            <option>2026</option>
            <option>2025</option>
            <option>2024</option>
            <option>2023</option>
            <option>2022</option>
            <option>2021</option>
            <option>2020</option>
          </select>
        </div>
        <button class="flex items-center gap-2 rounded-lg bg-primary px-6 py-2.5 text-sm font-medium text-white transition-colors hover:bg-primary-dark focus:outline-none focus:ring-2 focus:ring-primary/50 sm:w-auto w-full justify-center">
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
          Buscar
        </button>
      </div>
    </Card>

    <div class="mb-8">
      <h3 class="mb-4 text-sm font-semibold text-neutral-400 uppercase tracking-wide">Resultados — UF 2026</h3>
      <DataTable
        headers={["Fecha", "Valor", "Variación", "Fuente"]}
        rows={[
          ["02-06-2026", "$38.492,15", "+0,23%", "mindicador.cl"],
          ["01-06-2026", "$38.403,20", "+0,15%", "mindicador.cl"],
          ["31-05-2026", "$38.345,10", "-0,08%", "mindicador.cl"],
          ["30-05-2026", "$38.376,50", "+0,12%", "mindicador.cl"],
          ["29-05-2026", "$38.330,80", "+0,05%", "mindicador.cl"],
          ["28-05-2026", "$38.311,40", "-0,03%", "mindicador.cl"],
          ["27-05-2026", "$38.323,90", "+0,19%", "mindicador.cl"],
        ]}
      />
    </div>

    <div class="grid grid-cols-1 gap-8 lg:grid-cols-2">
      <div>
        <h3 class="mb-4 text-sm font-semibold text-neutral-400 uppercase tracking-wide">Estado Vacío</h3>
        <DataTable
          headers={["Fecha", "Valor", "Variación", "Fuente"]}
          rows={[]}
          empty={true}
        />
      </div>
      <div>
        <h3 class="mb-4 text-sm font-semibold text-neutral-400 uppercase tracking-wide">Estado de Error</h3>
        <DataTable
          headers={["Fecha", "Valor", "Variación", "Fuente"]}
          rows={[]}
          error={true}
        />
      </div>
    </div>
  </div>
</BaseLayout>
