---
import BaseLayout from '../layouts/BaseLayout.astro';
import Card from '../components/ui/Card.astro';
import DataTable from '../components/ui/DataTable.astro';
---

<BaseLayout title="Búsqueda Histórica" currentPath="/busqueda-historica/">
  <div class="mx-auto max-w-6xl">
    <div class="mb-7">
      <h2 class="text-xl font-bold tracking-tight text-white sm:text-2xl">Búsqueda Histórica</h2>
      <p class="mt-0.5 text-sm text-slate-500">Consulta el valor histórico de indicadores financieros chilenos</p>
    </div>

    <Card class="mb-7">
      <div class="flex flex-col gap-3 sm:flex-row sm:items-end">
        <div class="flex-1">
          <label for="currency" class="mb-1.5 block text-[10px] font-semibold uppercase tracking-widest text-slate-500">Indicador</label>
          <div class="relative">
            <svg class="pointer-events-none absolute left-3 top-1/2 h-3.5 w-3.5 -translate-y-1/2 text-slate-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" />
            </svg>
            <select id="currency" class="w-full appearance-none rounded-lg border border-slate-700/60 bg-slate-800/50 py-2.5 pl-9 pr-8 text-sm text-slate-200 outline-none transition-colors focus:border-emerald-500/50 focus:ring-1 focus:ring-emerald-500/20">
              <option>Unidad de Fomento (UF)</option>
              <option>UTM</option>
              <option>Dólar Observado (USD)</option>
              <option>Euro (EUR)</option>
              <option>IPC</option>
            </select>
            <svg class="pointer-events-none absolute right-2.5 top-1/2 h-4 w-4 -translate-y-1/2 text-slate-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
            </svg>
          </div>
        </div>
        <div class="flex-1">
          <label for="year" class="mb-1.5 block text-[10px] font-semibold uppercase tracking-widest text-slate-500">Año</label>
          <div class="relative">
            <svg class="pointer-events-none absolute left-3 top-1/2 h-3.5 w-3.5 -translate-y-1/2 text-slate-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 11.25v7.5" />
            </svg>
            <select id="year" class="w-full appearance-none rounded-lg border border-slate-700/60 bg-slate-800/50 py-2.5 pl-9 pr-8 text-sm text-slate-200 outline-none transition-colors focus:border-emerald-500/50 focus:ring-1 focus:ring-emerald-500/20">
              <option>2026</option>
              <option>2025</option>
              <option>2024</option>
              <option>2023</option>
              <option>2022</option>
              <option>2021</option>
              <option>2020</option>
            </select>
            <svg class="pointer-events-none absolute right-2.5 top-1/2 h-4 w-4 -translate-y-1/2 text-slate-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
            </svg>
          </div>
        </div>
        <button class="flex items-center justify-center gap-2 rounded-lg bg-emerald-600 px-5 py-2.5 text-sm font-medium text-white transition-all hover:bg-emerald-500 active:scale-[0.97] sm:w-auto w-full">
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
          Buscar
        </button>
      </div>
    </Card>

    <div class="mb-6">
      <div class="mb-3 flex items-center justify-between">
        <h3 class="text-xs font-semibold uppercase tracking-widest text-slate-600">Resultados — UF 2026</h3>
        <span class="inline-flex items-center gap-1.5 rounded-full bg-emerald-500/8 px-2 py-0.5 text-[10px] font-medium text-emerald-400">7 registros</span>
      </div>
      <DataTable
        headers={["Fecha", "Valor", "Variación", "Fuente"]}
        rows={[
          ["02-06-2026", "$38.492,15", "+0,23%", "mindicador.cl"],
          ["01-06-2026", "$38.403,20", "+0,15%", "mindicador.cl"],
          ["31-05-2026", "$38.345,10", "-0,08%", "mindicador.cl"],
          ["30-05-2026", "$38.376,50", "+0,12%", "mindicador.cl"],
          ["29-05-2026", "$38.330,80", "+0,05%", "mindicador.cl"],
          ["28-05-2026", "$38.311,40", "-0,03%", "mindicador.cl"],
          ["27-05-2026", "$38.323,90", "+0,19%", "mindicador.cl"],
        ]}
      />
    </div>

    <div class="grid grid-cols-1 gap-6 lg:grid-cols-2">
      <div>
        <h3 class="mb-3 text-xs font-semibold uppercase tracking-widest text-slate-600">Estado Vacío</h3>
        <DataTable headers={["Fecha", "Valor", "Variación", "Fuente"]} rows={[]} empty={true} />
      </div>
      <div>
        <h3 class="mb-3 text-xs font-semibold uppercase tracking-widest text-slate-600">Estado de Error</h3>
        <DataTable headers={["Fecha", "Valor", "Variación", "Fuente"]} rows={[]} error={true} />
      </div>
    </div>
  </div>
</BaseLayout>
