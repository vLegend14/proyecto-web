---
import BaseLayout from '../layouts/BaseLayout.astro';
import Card from '../components/ui/Card.astro';
import DataTable from '../components/ui/DataTable.astro';
---

<BaseLayout title="Búsqueda Histórica" currentPath="/busqueda-historica/">
  <div class="max-w-7xl animate-fade-in">
    <div class="mb-8">
      <h2 class="text-2xl font-bold text-white">Búsqueda Histórica</h2>
      <p class="mt-1 text-sm text-neutral-400">Consulta el valor histórico de indicadores financieros chilenos</p>
    </div>

    <Card class="mb-8">
      <div class="flex flex-col gap-4 sm:flex-row sm:items-end">
        <div class="flex-1">
          <label for="currency" class="mb-1.5 block text-xs font-medium text-neutral-400 uppercase tracking-wide">Indicador</label>
          <div class="relative">
            <svg class="pointer-events-none absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-neutral-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" />
            </svg>
            <select id="currency" class="w-full appearance-none rounded-lg border border-neutral-700 bg-neutral-800 py-2.5 pl-10 pr-8 text-sm text-white outline-none transition-colors focus:border-primary focus:ring-1 focus:ring-primary">
              <option>Unidad de Fomento (UF)</option>
              <option>Unidad Tributaria Mensual (UTM)</option>
              <option>Dólar Observado (USD)</option>
              <option>Euro Comercial (EUR)</option>
              <option>Índice de Precios al Consumidor (IPC)</option>
            </select>
            <svg class="pointer-events-none absolute right-3 top-1/2 h-4 w-4 -translate-y-1/2 text-neutral-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </div>
        </div>
        <div class="flex-1">
          <label for="year" class="mb-1.5 block text-xs font-medium text-neutral-400 uppercase tracking-wide">Año</label>
          <div class="relative">
            <svg class="pointer-events-none absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-neutral-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
            </svg>
            <select id="year" class="w-full appearance-none rounded-lg border border-neutral-700 bg-neutral-800 py-2.5 pl-10 pr-8 text-sm text-white outline-none transition-colors focus:border-primary focus:ring-1 focus:ring-primary">
              <option>2026</option>
              <option>2025</option>
              <option>2024</option>
              <option>2023</option>
              <option>2022</option>
              <option>2021</option>
              <option>2020</option>
            </select>
            <svg class="pointer-events-none absolute right-3 top-1/2 h-4 w-4 -translate-y-1/2 text-neutral-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </div>
        </div>
        <button class="flex items-center justify-center gap-2 rounded-lg bg-primary px-6 py-2.5 text-sm font-medium text-white transition-all duration-200 hover:bg-primary-dark hover:shadow-lg hover:shadow-primary/20 focus:outline-none focus:ring-2 focus:ring-primary/50 sm:w-auto w-full">
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
          Buscar
        </button>
      </div>
    </Card>

    <div class="mb-6">
      <div class="mb-4 flex items-center justify-between">
        <h3 class="text-sm font-semibold text-neutral-400 uppercase tracking-wide">Resultados — UF 2026</h3>
        <span class="flex items-center gap-1.5 rounded-full bg-emerald-500/10 px-2.5 py-1 text-xs text-emerald-400">
          <span class="h-1.5 w-1.5 rounded-full bg-emerald-400" />
          {7} registros
        </span>
      </div>
      <DataTable
        headers={["Fecha", "Valor", "Variación", "Fuente"]}
        rows={[
          ["02-06-2026", "$38.492,15", "+0,23%", "mindicador.cl"],
          ["01-06-2026", "$38.403,20", "+0,15%", "mindicador.cl"],
          ["31-05-2026", "$38.345,10", "-0,08%", "mindicador.cl"],
          ["30-05-2026", "$38.376,50", "+0,12%", "mindicador.cl"],
          ["29-05-2026", "$38.330,80", "+0,05%", "mindicador.cl"],
          ["28-05-2026", "$38.311,40", "-0,03%", "mindicador.cl"],
          ["27-05-2026", "$38.323,90", "+0,19%", "mindicador.cl"],
        ]}
      />
    </div>

    <div class="grid grid-cols-1 gap-6 lg:grid-cols-2">
      <div>
        <h3 class="mb-4 text-sm font-semibold text-neutral-400 uppercase tracking-wide">Estado Vacío</h3>
        <DataTable
          headers={["Fecha", "Valor", "Variación", "Fuente"]}
          rows={[]}
          empty={true}
        />
      </div>
      <div>
        <h3 class="mb-4 text-sm font-semibold text-neutral-400 uppercase tracking-wide">Estado de Error</h3>
        <DataTable
          headers={["Fecha", "Valor", "Variación", "Fuente"]}
          rows={[]}
          error={true}
        />
      </div>
    </div>
  </div>
</BaseLayout>
