---
import BaseLayout from '../layouts/BaseLayout.astro';
import Card from '../components/ui/Card.astro';
import Skeleton from '../components/ui/Skeleton.astro';

const hour = new Date().getHours();
const greeting = hour < 12 ? "Buenos días" : hour < 18 ? "Buenas tardes" : "Buenas noches";

const dateStr = new Date().toLocaleDateString("es-CL", {
  weekday: "long",
  day: "numeric",
  month: "long",
  year: "numeric",
});
const capitalizedDate = dateStr.charAt(0).toUpperCase() + dateStr.slice(1);
---

<BaseLayout title="Dashboard" currentPath="/">
  <div class="mx-auto max-w-6xl">
    <div class="mb-7 flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between">
      <div>
        <h2 class="text-xl font-bold tracking-tight text-white sm:text-2xl">{greeting}👋</h2>
        <p class="mt-0.5 text-sm text-slate-500">{capitalizedDate}</p>
      </div>
      <div class="flex items-center gap-3">
        <span class="inline-flex items-center gap-1.5 rounded-full bg-emerald-500/8 px-2.5 py-1 text-[11px] font-medium text-emerald-400 ring-1 ring-emerald-500/15">
          <span class="h-1.5 w-1.5 rounded-full bg-emerald-500" style="animation: pulse-dot 2s infinite" />
          Sincronizado hace 2 min
        </span>
      </div>
    </div>

    <div class="mb-7 grid grid-cols-2 gap-3 sm:gap-4 xl:grid-cols-4">
      {[
        { label: "Unidad de Fomento", code: "UF", value: "$38.492", change: "+0,23%", up: true, sub: "CLP", time: "hace 5 min" },
        { label: "UTM", code: "UTM", value: "$67.294", change: "+0,18%", up: true, sub: "CLP", time: "hace 12 min" },
        { label: "Dólar Observado", code: "USD", value: "$956", change: "-0,45%", up: false, sub: "CLP", time: "hace 3 min" },
        { label: "Euro", code: "EUR", value: "$1.043", change: "+0,31%", up: true, sub: "CLP", time: "hace 7 min" },
      ].map((k, i) => (
        <Card class="animate-slide-up" style={`animation-delay: ${i * 0.08}s`}>
          <div class="flex items-start justify-between">
            <div class="flex h-9 w-9 items-center justify-center rounded-lg bg-emerald-500/8 ring-1 ring-emerald-500/10">
              <span class="text-[10px] font-bold tracking-wide text-emerald-400">{k.code}</span>
            </div>
            <span class={`inline-flex items-center gap-0.5 rounded-full px-1.5 py-0.5 text-[11px] font-medium ${
              k.up ? "bg-emerald-500/8 text-emerald-400" : "bg-red-500/8 text-red-400"
            }`}>
              <svg class="h-2.5 w-2.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
                <path stroke-linecap="round" stroke-linejoin="round" d={k.up ? "M5 10l7-7m0 0l7 7m-7-7v18" : "M19 14l-7 7m0 0l-7-7m7 7V3"} />
              </svg>
              {k.change}
            </span>
          </div>
          <div class="mt-3">
            <p class="text-[11px] font-medium text-slate-500">{k.label}</p>
            <div class="mt-0.5 flex items-baseline gap-1.5">
              <span class="text-2xl font-bold tracking-tight text-white">{k.value}</span>
              <span class="text-[11px] text-slate-600">{k.sub}</span>
            </div>
          </div>
          <div class="mt-2 flex items-center gap-1.5 text-[10px] text-slate-600">
            <svg class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            {k.time}
          </div>
        </Card>
      ))}
    </div>

    <div class="mb-7 grid grid-cols-1 gap-5 lg:grid-cols-3">
      <Card class="lg:col-span-2" style="animation: slideUp 0.4s ease-out 0.3s both">
        <div class="mb-1 flex items-center justify-between">
          <h3 class="text-xs font-semibold uppercase tracking-widest text-slate-600">Resumen del Mercado</h3>
          <span class="text-[10px] text-slate-600">Actualizado hoy</span>
        </div>
        <div class="divide-y divide-slate-800/50">
          {[
            { label: "IPC Acumulado 2026", value: "+2,8%", up: true, detail: "vs +3,1% esperado" },
            { label: "Tasa de Desempleo", value: "8,2%", up: false, detail: "vs 7,9% mes anterior" },
            { label: "IMACEC", value: "+2,1%", up: true, detail: "vs +1,8% en marzo" },
            { label: "Libra de Cobre", value: "$4,12", up: true, detail: "+0,8% en la semana" },
          ].map((item) => (
            <div class="flex items-center justify-between py-3 first:pt-0 last:pb-0">
              <div>
                <p class="text-sm font-medium text-slate-300">{item.label}</p>
                <p class="mt-0.5 text-xs text-slate-600">{item.detail}</p>
              </div>
              <div class="flex items-center gap-2">
                <span class="text-base font-semibold text-white">{item.value}</span>
                <span class={`flex h-5 w-5 items-center justify-center rounded ${item.up ? "bg-emerald-500/8 text-emerald-400" : "bg-red-500/8 text-red-400"}`}>
                  <svg class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d={item.up ? "M5 10l7-7m0 0l7 7m-7-7v18" : "M19 14l-7 7m0 0l-7-7m7 7V3"} />
                  </svg>
                </span>
              </div>
            </div>
          ))}
        </div>
      </Card>

      <Card style="animation: slideUp 0.4s ease-out 0.4s both">
        <div class="mb-1 flex items-center justify-between">
          <h3 class="text-xs font-semibold uppercase tracking-widest text-slate-600">Alertas</h3>
          <span class="text-[10px] text-emerald-500">3 activas</span>
        </div>
        <div class="space-y-2.5">
          {[
            { icon: "M12 9v3.75m9-.75a9 9 0 11-18 0 9 9 0 0118 0zm-9 3.75h.008v.008H12v-.008z", color: "text-amber-400", bg: "bg-amber-500/8", title: "Dólar en alza", desc: "Superó resistencia de $950" },
            { icon: "M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z", color: "text-emerald-400", bg: "bg-emerald-500/8", title: "UF estable", desc: "Variación dentro de lo esperado" },
            { icon: "M12 9v3.75m-3 3.375A9.626 9.626 0 0012 21c5.162 0 9.375-4.088 9.375-9.15 0-1.17-.224-2.286-.632-3.307M12 3c-5.162 0-9.375 4.088-9.375 9.15 0 1.17.224 2.286.632 3.307", color: "text-blue-400", bg: "bg-blue-500/8", title: "IPC favorable", desc: "Inflación bajo lo proyectado" },
          ].map((item) => (
            <div class="flex items-start gap-2.5 rounded-lg bg-slate-800/15 p-2.5">
              <div class={`flex h-7 w-7 flex-shrink-0 items-center justify-center rounded-md ${item.bg}`}>
                <svg class={`h-3.5 w-3.5 ${item.color}`} fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d={item.icon} />
                </svg>
              </div>
              <div class="min-w-0">
                <p class="text-sm font-medium text-slate-200">{item.title}</p>
                <p class="mt-0.5 text-xs text-slate-500">{item.desc}</p>
              </div>
            </div>
          ))}
        </div>
      </Card>
    </div>

    <div style="animation: slideUp 0.4s ease-out 0.5s both">
      <div class="mb-3 flex items-center gap-2">
        <h3 class="text-xs font-semibold uppercase tracking-widest text-slate-600">Cargando indicadores</h3>
        <div class="flex gap-1">
          <span class="h-1 w-1 rounded-full bg-slate-600" style="animation: pulse-dot 1.5s infinite" />
          <span class="h-1 w-1 rounded-full bg-slate-600" style="animation: pulse-dot 1.5s infinite 0.3s" />
          <span class="h-1 w-1 rounded-full bg-slate-600" style="animation: pulse-dot 1.5s infinite 0.6s" />
        </div>
      </div>
      <div class="grid grid-cols-2 gap-3 sm:grid-cols-4">
        {[1, 2, 3, 4].map((i) => (
          <Card hover={false}>
            <div class="flex items-start justify-between">
              <Skeleton variant="rect" class="h-9 w-9" />
              <Skeleton variant="rect" class="h-5 w-14 rounded-full" />
            </div>
            <div class="mt-3 space-y-2">
              <Skeleton variant="text" class="h-3 w-20" />
              <Skeleton variant="text" class="h-7 w-24" />
              <Skeleton variant="text" class="h-2.5 w-16" />
            </div>
          </Card>
        ))}
      </div>
    </div>
  </div>
</BaseLayout>
