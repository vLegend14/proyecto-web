---
import BaseLayout from '../layouts/BaseLayout.astro';
import KpiCard from '../components/ui/KpiCard.astro';
import Skeleton from '../components/ui/Skeleton.astro';
import Card from '../components/ui/Card.astro';
---

<BaseLayout title="Dashboard" currentPath="/">
  <div class="max-w-7xl">
    <div class="mb-8">
      <h2 class="text-2xl font-bold text-white">Panel Principal</h2>
      <p class="mt-1 text-sm text-neutral-400">Resumen de indicadores financieros actualizados</p>
    </div>

    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 xl:grid-cols-4">
      <KpiCard
        label="Unidad de Fomento (UF)"
        value="$38.492,15"
        time="hace 5 min"
        trend="up"
        trendLabel="+0,23%"
        icon="uf"
      />
      <KpiCard
        label="Unidad Tributaria Mensual (UTM)"
        value="$67.294,00"
        time="hace 12 min"
        trend="up"
        trendLabel="+0,18%"
        icon="utm"
      />
      <KpiCard
        label="Dólar Observado (USD)"
        value="$956,32"
        time="hace 3 min"
        trend="down"
        trendLabel="-0,45%"
        icon="usd"
      />
      <KpiCard
        label="Euro Comercial (EUR)"
        value="$1.042,87"
        time="hace 7 min"
        trend="up"
        trendLabel="+0,31%"
        icon="eur"
      />
    </div>

    <div class="mt-8">
      <h3 class="mb-4 text-sm font-semibold text-neutral-400 uppercase tracking-wide">Cargando indicadores adicionales...</h3>
      <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 xl:grid-cols-4">
        {Array.from({ length: 4 }).map((_) => (
          <Card>
            <Skeleton class="mb-3 h-10 w-10 rounded-lg" />
            <Skeleton class="mb-2 h-3 w-24 rounded" />
            <Skeleton class="mb-1 h-6 w-32 rounded" />
            <Skeleton class="h-3 w-20 rounded" />
          </Card>
        ))}
      </div>
    </div>
  </div>
</BaseLayout>
