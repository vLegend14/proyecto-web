---
import BaseLayout from '../layouts/BaseLayout.astro';
import KpiCard from '../components/ui/KpiCard.astro';
import Skeleton from '../components/ui/Skeleton.astro';
import Card from '../components/ui/Card.astro';

const hour = new Date().getHours();
const greeting = hour < 12 ? "Buenos días" : hour < 18 ? "Buenas tardes" : "Buenas noches";

const dateStr = new Date().toLocaleDateString("es-CL", {
  weekday: "long",
  day: "numeric",
  month: "long",
  year: "numeric",
});
const capitalizedDate = dateStr.charAt(0).toUpperCase() + dateStr.slice(1);
---

<BaseLayout title="Dashboard" currentPath="/">
  <div class="max-w-7xl">
    <div class="mb-8 flex flex-col gap-1 sm:flex-row sm:items-center sm:justify-between">
      <div>
        <h2 class="text-2xl font-bold text-white">{greeting}, Usuario</h2>
        <p class="mt-1 text-sm text-neutral-400">{capitalizedDate}</p>
      </div>
      <div class="mt-3 flex items-center gap-2 sm:mt-0">
        <span class="flex items-center gap-1.5 rounded-full bg-emerald-500/10 px-3 py-1.5 text-xs font-medium text-emerald-400">
          <span class="h-1.5 w-1.5 rounded-full bg-emerald-400 animate-pulse" />
          Última actualización: hace 2 min
        </span>
      </div>
    </div>

    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 xl:grid-cols-4">
      <KpiCard
        label="Unidad de Fomento (UF)"
        value="$38.492,15"
        time="hace 5 min"
        trend="up"
        trendLabel="+0,23%"
        icon="uf"
        stagger="stagger-1"
      />
      <KpiCard
        label="Unidad Tributaria Mensual (UTM)"
        value="$67.294,00"
        time="hace 12 min"
        trend="up"
        trendLabel="+0,18%"
        icon="utm"
        stagger="stagger-2"
      />
      <KpiCard
        label="Dólar Observado (USD)"
        value="$956,32"
        time="hace 3 min"
        trend="down"
        trendLabel="-0,45%"
        icon="usd"
        stagger="stagger-3"
      />
      <KpiCard
        label="Euro Comercial (EUR)"
        value="$1.042,87"
        time="hace 7 min"
        trend="up"
        trendLabel="+0,31%"
        icon="eur"
        stagger="stagger-4"
      />
    </div>

    <div class="mt-6 grid grid-cols-1 gap-6 lg:grid-cols-3">
      <Card class="lg:col-span-2 animate-slide-up stagger-3">
        <h3 class="mb-4 text-sm font-semibold text-neutral-400 uppercase tracking-wide">Resumen del Mercado</h3>
        <div class="space-y-3">
          {[
            { label: "IPC Acumulado 2026", value: "+2,8%", change: "up", detail: "vs +3,1% esperado" },
            { label: "Tasa de Desempleo", value: "8,2%", change: "down", detail: "vs 7,9% mes anterior" },
            { label: "IMACEC (Abril)", value: "+2,1%", change: "up", detail: "vs +1,8% marzo" },
            { label: "Libra de Cobre", value: "$4,12 USD", change: "up", detail: "+0,8% en la semana" },
          ].map((item) => (
            <div class="flex items-center justify-between rounded-lg bg-neutral-800/30 px-4 py-3">
              <div>
                <p class="text-sm text-neutral-400">{item.label}</p>
                <p class="mt-0.5 text-xs text-neutral-600">{item.detail}</p>
              </div>
              <div class="flex items-center gap-2">
                <span class="text-lg font-semibold text-white">{item.value}</span>
                <svg class="h-4 w-4 {item.change === 'up' ? 'text-emerald-400' : 'text-red-400'}" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  {item.change === "up"
                    ? <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 10l7-7m0 0l7 7m-7-7v18" />
                    : <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
                  }
                </svg>
              </div>
            </div>
          ))}
        </div>
      </Card>

      <Card class="animate-slide-up stagger-4">
        <h3 class="mb-4 text-sm font-semibold text-neutral-400 uppercase tracking-wide">Alertas Recientes</h3>
        <div class="space-y-3">
          {[
            { icon: "M12 9v2m0 4h.01", color: "text-amber-400", bg: "bg-amber-500/10", title: "Dólar en alza", desc: "Superó resistencia de $950" },
            { icon: "M13 16h-1v-4h-1m1-4h.01", color: "text-blue-400", bg: "bg-blue-500/10", title: "UF estable", desc: "Variación dentro de lo esperado" },
            { icon: "M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126z", color: "text-emerald-400", bg: "bg-emerald-500/10", title: "IPC favorable", desc: "Inflación bajo lo proyectado" },
          ].map((item) => (
            <div class="flex items-start gap-3 rounded-lg bg-neutral-800/20 p-3">
              <div class="flex h-8 w-8 flex-shrink-0 items-center justify-center rounded-lg {item.bg}">
                <svg class="h-4 w-4 {item.color}" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={item.icon} />
                </svg>
              </div>
              <div>
                <p class="text-sm font-medium text-white">{item.title}</p>
                <p class="mt-0.5 text-xs text-neutral-500">{item.desc}</p>
              </div>
            </div>
          ))}
        </div>
      </Card>
    </div>

    <div class="mt-6 animate-slide-up stagger-5">
      <h3 class="mb-4 text-sm font-semibold text-neutral-400 uppercase tracking-wide">Cargando indicadores adicionales</h3>
      <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 xl:grid-cols-4">
        {[1, 2, 3, 4].map((i) => (
          <Card hover={false}>
            <Skeleton class="mb-3 h-11 w-11 rounded-xl" />
            <Skeleton class="mb-2 h-3 w-24 rounded" />
            <Skeleton class="mb-1 h-7 w-32 rounded" />
            <Skeleton class="h-3 w-20 rounded" />
          </Card>
        ))}
      </div>
    </div>
  </div>
</BaseLayout>
