---
import BaseLayout from '../layouts/BaseLayout.astro';
import Card from '../components/ui/Card.astro';
import CodeBlock from '../components/ui/CodeBlock.astro';
---

<BaseLayout title="API Info" currentPath="/api-info/">
  <div class="mx-auto max-w-6xl">
    <div class="mb-7">
      <h2 class="text-xl font-bold tracking-tight text-white sm:text-2xl">API Info</h2>
      <p class="mt-0.5 text-sm text-slate-500">Documentación técnica de los endpoints para consulta de indicadores</p>
    </div>

    <div class="grid grid-cols-1 gap-6 lg:grid-cols-3">
      <div class="lg:col-span-2 space-y-5">
        <Card>
          <div class="mb-4 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
            <div class="flex items-center gap-3">
              <div class="flex h-9 w-9 items-center justify-center rounded-lg bg-blue-500/8 ring-1 ring-blue-500/10">
                <svg class="h-[18px] w-[18px] text-blue-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" />
                </svg>
              </div>
              <div>
                <h3 class="text-sm font-semibold text-slate-200">Obtener Indicador</h3>
                <p class="text-xs text-slate-500">Valor actual de un indicador específico</p>
              </div>
            </div>
            <span class="inline-flex items-center gap-1 rounded-full bg-emerald-500/8 px-2 py-0.5 text-[11px] font-medium text-emerald-400 self-start sm:self-center">GET</span>
          </div>
          <div class="rounded-lg bg-slate-950/60 px-4 py-2.5 font-mono text-sm text-slate-300">
            <span class="text-emerald-400 font-semibold">GET</span> https://api.mindicador.cl/api/&#123;tipo&#125;
          </div>
          <div class="mt-4 grid grid-cols-1 gap-4 sm:grid-cols-2">
            <div>
              <p class="mb-2 text-[10px] font-semibold uppercase tracking-widest text-slate-600">Parámetros</p>
              <div class="rounded-lg bg-slate-800/15 px-3 py-2">
                <p><span class="font-mono text-xs text-blue-400">tipo</span> <span class="text-red-400/70 text-[10px]">*requerido</span></p>
                <p class="mt-0.5 text-xs text-slate-600">Código: uf, utm, dolar, euro, ipc</p>
              </div>
            </div>
            <div>
              <p class="mb-2 text-[10px] font-semibold uppercase tracking-widest text-slate-600">Respuesta</p>
              <div class="space-y-1.5">
                <div class="flex items-center gap-2 rounded-lg bg-emerald-500/5 px-3 py-2">
                  <span class="flex h-5 w-5 items-center justify-center rounded bg-emerald-500/15 text-[10px] font-bold text-emerald-400">200</span>
                  <span class="text-xs text-slate-500">Indicador encontrado</span>
                </div>
                <div class="flex items-center gap-2 rounded-lg bg-red-500/5 px-3 py-2">
                  <span class="flex h-5 w-5 items-center justify-center rounded bg-red-500/15 text-[10px] font-bold text-red-400">404</span>
                  <span class="text-xs text-slate-500">No encontrado</span>
                </div>
              </div>
            </div>
          </div>
        </Card>

        <Card>
          <div class="mb-4 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
            <div class="flex items-center gap-3">
              <div class="flex h-9 w-9 items-center justify-center rounded-lg bg-blue-500/8 ring-1 ring-blue-500/10">
                <svg class="h-[18px] w-[18px] text-blue-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 11.25v7.5" />
                </svg>
              </div>
              <div>
                <h3 class="text-sm font-semibold text-slate-200">Historial por Año</h3>
                <p class="text-xs text-slate-500">Historial completo de un indicador en un año</p>
              </div>
            </div>
            <span class="inline-flex items-center gap-1 rounded-full bg-emerald-500/8 px-2 py-0.5 text-[11px] font-medium text-emerald-400 self-start sm:self-center">GET</span>
          </div>
          <div class="rounded-lg bg-slate-950/60 px-4 py-2.5 font-mono text-sm text-slate-300">
            <span class="text-emerald-400 font-semibold">GET</span> https://api.mindicador.cl/api/&#123;tipo&#125;/&#123;año&#125;
          </div>
          <div class="mt-4 grid grid-cols-1 gap-4 sm:grid-cols-2">
            <div>
              <p class="mb-2 text-[10px] font-semibold uppercase tracking-widest text-slate-600">Parámetros</p>
              <div class="space-y-1.5">
                <div class="rounded-lg bg-slate-800/15 px-3 py-2">
                  <p><span class="font-mono text-xs text-blue-400">tipo</span> <span class="text-red-400/70 text-[10px]">*requerido</span></p>
                  <p class="mt-0.5 text-xs text-slate-600">Código del indicador</p>
                </div>
                <div class="rounded-lg bg-slate-800/15 px-3 py-2">
                  <p><span class="font-mono text-xs text-blue-400">año</span> <span class="text-red-400/70 text-[10px]">*requerido</span></p>
                  <p class="mt-0.5 text-xs text-slate-600">Ej: 2026</p>
                </div>
              </div>
            </div>
            <div>
              <p class="mb-2 text-[10px] font-semibold uppercase tracking-widest text-slate-600">Respuesta</p>
              <div class="flex items-center gap-2 rounded-lg bg-emerald-500/5 px-3 py-2">
                <span class="flex h-5 w-5 items-center justify-center rounded bg-emerald-500/15 text-[10px] font-bold text-emerald-400">200</span>
                <span class="text-xs text-slate-500">Array con fecha y valor</span>
              </div>
            </div>
          </div>
        </Card>

        <Card>
          <div class="mb-4 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
            <div class="flex items-center gap-3">
              <div class="flex h-9 w-9 items-center justify-center rounded-lg bg-blue-500/8 ring-1 ring-blue-500/10">
                <svg class="h-[18px] w-[18px] text-blue-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
              </div>
              <div>
                <h3 class="text-sm font-semibold text-slate-200">Listar Indicadores</h3>
                <p class="text-xs text-slate-500">Todos los indicadores disponibles</p>
              </div>
            </div>
            <span class="inline-flex items-center gap-1 rounded-full bg-emerald-500/8 px-2 py-0.5 text-[11px] font-medium text-emerald-400 self-start sm:self-center">GET</span>
          </div>
          <div class="rounded-lg bg-slate-950/60 px-4 py-2.5 font-mono text-sm text-slate-300">
            <span class="text-emerald-400 font-semibold">GET</span> https://api.mindicador.cl/api
          </div>
          <div class="mt-3">
            <p class="text-xs text-slate-500">Objeto con todos los indicadores disponibles y sus valores actuales.</p>
          </div>
        </Card>

        <Card>
          <div class="mb-4 flex items-center gap-3">
            <div class="flex h-9 w-9 items-center justify-center rounded-lg bg-emerald-500/8 ring-1 ring-emerald-500/10">
              <svg class="h-[18px] w-[18px] text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M17.25 6.75L22.5 12l-5.25 5.25m-10.5 0L1.5 12l5.25-5.25m7.5-3l-4.5 16.5" />
              </svg>
            </div>
            <div>
              <h3 class="text-sm font-semibold text-slate-200">Ejemplo de Respuesta</h3>
              <p class="text-xs text-slate-500">Formato JSON devuelto por la API</p>
            </div>
          </div>
          <CodeBlock code={JSON.stringify({
            version: "1.7.0",
            autor: "mindicador.cl",
            fecha: "2026-06-25T19:00:00.000Z",
            uf: { codigo: "uf", nombre: "Unidad de Fomento (UF)", unidad_medida: "Pesos", fecha: "2026-06-25", valor: 38492.15 },
            dolar: { codigo: "dolar", nombre: "Dólar observado", unidad_medida: "Pesos", fecha: "2026-06-25", valor: 956.32 }
          }, null, 2)} />
          <p class="mt-2 text-[10px] text-slate-600">* Datos ilustrativos</p>
        </Card>
      </div>

      <div class="space-y-4">
        <Card>
          <h3 class="mb-3 text-xs font-semibold uppercase tracking-widest text-slate-600">Indicadores</h3>
          <div class="space-y-1">
            {["uf", "utm", "dolar", "euro", "ipc", "libra_cobre", "tasa_desempleo", "imacec"].map((code) => (
              <div class="flex items-center justify-between rounded-lg bg-slate-800/10 px-3 py-2 transition-colors hover:bg-slate-800/30">
                <span class="font-mono text-[11px] text-blue-400">{code}</span>
                <span class="text-[11px] text-slate-600">{code === "uf" ? "UF" : code === "utm" ? "UTM" : code === "dolar" ? "Dólar" : code === "euro" ? "Euro" : code === "ipc" ? "IPC" : code === "libra_cobre" ? "Cobre" : code === "tasa_desempleo" ? "Desempleo" : "IMACEC"}</span>
              </div>
            ))}
          </div>
        </Card>

        <Card>
          <div class="flex items-start gap-3">
            <div class="flex h-9 w-9 flex-shrink-0 items-center justify-center rounded-lg bg-emerald-500/8 ring-1 ring-emerald-500/10">
              <svg class="h-[18px] w-[18px] text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M11.25 11.25l.041-.02a.75.75 0 011.063.852l-.708 2.836a.75.75 0 001.063.853l.041-.021M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-9-3.75h.008v.008H12V8.25z" />
              </svg>
            </div>
            <div>
              <h3 class="text-sm font-semibold text-slate-200">mindicador.cl</h3>
              <p class="text-xs text-slate-500 mt-0.5">API pública de indicadores chilenos</p>
            </div>
          </div>
          <p class="mt-3 text-xs leading-relaxed text-slate-600">
            Los datos mostrados son proporcionados por la API pública de mindicador.cl. Esta interfaz es únicamente una capa de presentación.
          </p>
          <div class="mt-3 rounded-lg bg-slate-800/20 px-3 py-2.5 text-center">
            <a href="https://mindicador.cl" target="_blank" rel="noopener noreferrer" class="text-xs text-blue-400 hover:text-blue-300 transition-colors underline underline-offset-2">mindicador.cl</a>
            <span class="mx-1.5 text-slate-700">&middot;</span>
            <span class="text-xs text-slate-600">Datos referenciales</span>
          </div>
        </Card>
      </div>
    </div>
  </div>
</BaseLayout>
