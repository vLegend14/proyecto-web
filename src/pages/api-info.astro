---
import BaseLayout from '../layouts/BaseLayout.astro';
import Card from '../components/ui/Card.astro';
import Badge from '../components/ui/Badge.astro';
import CodeBlock from '../components/ui/CodeBlock.astro';
---

<BaseLayout title="API Info" currentPath="/api-info/">
  <div class="max-w-7xl animate-fade-in">
    <div class="mb-8">
      <h2 class="text-2xl font-bold text-white">API Info</h2>
      <p class="mt-1 text-sm text-neutral-400">Documentación técnica de los endpoints disponibles para consulta de indicadores económicos</p>
    </div>

    <div class="grid grid-cols-1 gap-6 lg:grid-cols-3">
      <div class="lg:col-span-2 space-y-6">
        <Card>
          <div class="mb-4 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
            <div class="flex items-center gap-3">
              <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-gradient-to-br from-secondary/20 to-secondary/5 ring-1 ring-secondary/10">
                <svg class="h-5 w-5 text-secondary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
                </svg>
              </div>
              <div>
                <h3 class="text-sm font-semibold text-white">Obtener Indicador</h3>
                <p class="text-xs text-neutral-500">Recupera el valor actual de un indicador específico</p>
              </div>
            </div>
            <Badge variant="primary" class="self-start sm:self-center">GET</Badge>
          </div>
          <div class="rounded-lg bg-neutral-950 px-4 py-3 font-mono text-sm text-neutral-300">
            <span class="text-secondary font-semibold">GET</span> https://api.mindicador.cl/api/&#123;tipo&#125;
          </div>
          <div class="mt-4 grid grid-cols-1 gap-4 sm:grid-cols-2">
            <div>
              <p class="mb-2 text-xs font-semibold text-neutral-400 uppercase tracking-wide">Parámetros</p>
              <div class="space-y-2 text-sm">
                <div class="rounded-lg bg-neutral-800/30 px-3 py-2">
                  <p><span class="font-mono text-xs text-secondary">tipo</span> <span class="text-red-400 text-xs">*requerido</span></p>
                  <p class="mt-0.5 text-xs text-neutral-500">Código del indicador: uf, utm, dolar, euro, ipc, etc.</p>
                </div>
              </div>
            </div>
            <div>
              <p class="mb-2 text-xs font-semibold text-neutral-400 uppercase tracking-wide">Respuesta</p>
              <div class="space-y-2">
                <div class="flex items-center gap-2 rounded-lg bg-emerald-500/5 px-3 py-2">
                  <span class="flex h-5 w-5 items-center justify-center rounded bg-emerald-500/20 text-xs font-bold text-emerald-400">200</span>
                  <span class="text-xs text-neutral-400">OK — Indicador encontrado</span>
                </div>
                <div class="flex items-center gap-2 rounded-lg bg-red-500/5 px-3 py-2">
                  <span class="flex h-5 w-5 items-center justify-center rounded bg-red-500/20 text-xs font-bold text-red-400">404</span>
                  <span class="text-xs text-neutral-400">No encontrado</span>
                </div>
              </div>
            </div>
          </div>
        </Card>

        <Card>
          <div class="mb-4 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
            <div class="flex items-center gap-3">
              <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-gradient-to-br from-secondary/20 to-secondary/5 ring-1 ring-secondary/10">
                <svg class="h-5 w-5 text-secondary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                </svg>
              </div>
              <div>
                <h3 class="text-sm font-semibold text-white">Historial por Año</h3>
                <p class="text-xs text-neutral-500">Recupera el historial completo de un indicador en un año específico</p>
              </div>
            </div>
            <Badge variant="primary" class="self-start sm:self-center">GET</Badge>
          </div>
          <div class="rounded-lg bg-neutral-950 px-4 py-3 font-mono text-sm text-neutral-300">
            <span class="text-secondary font-semibold">GET</span> https://api.mindicador.cl/api/&#123;tipo&#125;/&#123;año&#125;
          </div>
          <div class="mt-4 grid grid-cols-1 gap-4 sm:grid-cols-2">
            <div>
              <p class="mb-2 text-xs font-semibold text-neutral-400 uppercase tracking-wide">Parámetros</p>
              <div class="space-y-2 text-sm">
                <div class="rounded-lg bg-neutral-800/30 px-3 py-2">
                  <p><span class="font-mono text-xs text-secondary">tipo</span> <span class="text-red-400 text-xs">*requerido</span></p>
                  <p class="mt-0.5 text-xs text-neutral-500">Código del indicador</p>
                </div>
                <div class="rounded-lg bg-neutral-800/30 px-3 py-2">
                  <p><span class="font-mono text-xs text-secondary">año</span> <span class="text-red-400 text-xs">*requerido</span></p>
                  <p class="mt-0.5 text-xs text-neutral-500">Año a consultar (ej: 2026)</p>
                </div>
              </div>
            </div>
            <div>
              <p class="mb-2 text-xs font-semibold text-neutral-400 uppercase tracking-wide">Respuesta</p>
              <div class="flex items-center gap-2 rounded-lg bg-emerald-500/5 px-3 py-2">
                <span class="flex h-5 w-5 items-center justify-center rounded bg-emerald-500/20 text-xs font-bold text-emerald-400">200</span>
                <span class="text-xs text-neutral-400">Array de objetos con fecha y valor</span>
              </div>
            </div>
          </div>
        </Card>

        <Card>
          <div class="mb-4 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
            <div class="flex items-center gap-3">
              <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-gradient-to-br from-secondary/20 to-secondary/5 ring-1 ring-secondary/10">
                <svg class="h-5 w-5 text-secondary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
              </div>
              <div>
                <h3 class="text-sm font-semibold text-white">Listar Indicadores</h3>
                <p class="text-xs text-neutral-500">Obtiene la lista completa de indicadores disponibles</p>
              </div>
            </div>
            <Badge variant="primary" class="self-start sm:self-center">GET</Badge>
          </div>
          <div class="rounded-lg bg-neutral-950 px-4 py-3 font-mono text-sm text-neutral-300">
            <span class="text-secondary font-semibold">GET</span> https://api.mindicador.cl/api
          </div>
          <div class="mt-4">
            <p class="mb-2 text-xs font-semibold text-neutral-400 uppercase tracking-wide">Respuesta</p>
            <p class="text-sm text-neutral-400">Objeto con todos los indicadores disponibles y sus valores actuales.</p>
          </div>
        </Card>

        <Card>
          <div class="mb-4 flex items-center gap-3">
            <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-gradient-to-br from-primary/20 to-primary/5 ring-1 ring-primary/10">
              <svg class="h-5 w-5 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" />
              </svg>
            </div>
            <div>
              <h3 class="text-sm font-semibold text-white">Ejemplo de Respuesta</h3>
              <p class="text-xs text-neutral-500">Formato JSON devuelto por la API</p>
            </div>
          </div>
          <CodeBlock code={JSON.stringify({
            version: "1.7.0",
            autor: "mindicador.cl",
            fecha: "2026-06-25T19:00:00.000Z",
            uf: {
              codigo: "uf",
              nombre: "Unidad de Fomento (UF)",
              unidad_medida: "Pesos",
              fecha: "2026-06-25",
              valor: 38492.15
            },
            dolar: {
              codigo: "dolar",
              nombre: "Dólar observado",
              unidad_medida: "Pesos",
              fecha: "2026-06-25",
              valor: 956.32
            }
          }, null, 2)} filename="response.json" />
          <p class="mt-3 text-xs text-neutral-500">* Datos de ejemplo con fines ilustrativos</p>
        </Card>
      </div>

      <div class="space-y-4">
        <Card>
          <h3 class="mb-4 text-sm font-semibold text-white">Indicadores Disponibles</h3>
          <div class="space-y-1.5 text-sm">
            {[
              { code: "uf", name: "Unidad de Fomento" },
              { code: "utm", name: "UTM" },
              { code: "dolar", name: "Dólar Observado" },
              { code: "euro", name: "Euro" },
              { code: "ipc", name: "IPC" },
              { code: "libra_cobre", name: "Libra de Cobre" },
              { code: "tasa_desempleo", name: "Tasa de Desempleo" },
              { code: "imacec", name: "IMACEC" },
            ].map((item) => (
              <div class="group flex items-center justify-between rounded-lg bg-neutral-800/30 px-3 py-2.5 transition-colors hover:bg-neutral-800/60">
                <span class="font-mono text-xs text-secondary">{item.code}</span>
                <span class="text-xs text-neutral-400 group-hover:text-neutral-300 transition-colors">{item.name}</span>
              </div>
            ))}
          </div>
        </Card>

        <Card>
          <div class="flex items-start gap-3">
            <div class="flex h-11 w-11 flex-shrink-0 items-center justify-center rounded-xl bg-gradient-to-br from-primary/20 to-primary/5 ring-1 ring-primary/10">
              <svg class="h-5 w-5 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
            </div>
            <div>
              <h3 class="text-sm font-semibold text-white">mindicador.cl</h3>
              <p class="text-xs text-neutral-500 mt-0.5">API pública de indicadores chilenos</p>
            </div>
          </div>
          <p class="mt-4 text-xs leading-relaxed text-neutral-500">
            Los datos mostrados en esta aplicación son proporcionados por la API pública de mindicador.cl.
            Esta interfaz es únicamente una capa de presentación para visualizar y consultar dichos indicadores.
          </p>
          <div class="mt-4 rounded-lg bg-neutral-800/40 px-4 py-3 text-center">
            <a href="https://mindicador.cl" target="_blank" rel="noopener noreferrer" class="text-xs text-secondary hover:text-secondary-light transition-colors underline underline-offset-2">
              mindicador.cl
            </a>
            <span class="mx-2 text-xs text-neutral-600">·</span>
            <span class="text-xs text-neutral-500">Datos referenciales con fines informativos</span>
          </div>
        </Card>
      </div>
    </div>
  </div>
</BaseLayout>
