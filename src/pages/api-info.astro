---
import BaseLayout from '../layouts/BaseLayout.astro';
import Card from '../components/ui/Card.astro';
import Badge from '../components/ui/Badge.astro';
import CodeBlock from '../components/ui/CodeBlock.astro';
---

<BaseLayout title="API Info" currentPath="/api-info/">
  <div class="max-w-7xl">
    <div class="mb-8">
      <h2 class="text-2xl font-bold text-white">API Info</h2>
      <p class="mt-1 text-sm text-neutral-400">Documentación técnica de los endpoints disponibles para consulta de indicadores</p>
    </div>

    <div class="grid grid-cols-1 gap-6 lg:grid-cols-3">
      <div class="lg:col-span-2 space-y-6">
        <Card>
          <div class="mb-4 flex items-center justify-between">
            <div class="flex items-center gap-3">
              <div class="flex h-9 w-9 items-center justify-center rounded-lg bg-secondary/10">
                <svg class="h-5 w-5 text-secondary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
                </svg>
              </div>
              <div>
                <h3 class="text-sm font-semibold text-white">Obtener Indicador</h3>
                <p class="text-xs text-neutral-500">Recupera el valor actual de un indicador específico</p>
              </div>
            </div>
            <Badge variant="primary">GET</Badge>
          </div>
          <div class="rounded-lg bg-neutral-950 px-4 py-2.5 font-mono text-sm text-neutral-300">
            <span class="text-neutral-500">GET</span> https://api.mindicador.cl/api/&#123;tipo&#125;
          </div>
          <div class="mt-4 grid grid-cols-1 gap-3 sm:grid-cols-2">
            <div>
              <p class="mb-1 text-xs text-neutral-500">Parámetros</p>
              <div class="space-y-1 text-sm text-neutral-400">
                <p><span class="text-neutral-300">tipo</span> (string, requerido) — Código del indicador</p>
                <p class="text-xs text-neutral-500">Valores: uf, utm, dolar, euro, ipc, etc.</p>
              </div>
            </div>
            <div>
              <p class="mb-1 text-xs text-neutral-500">Respuesta</p>
              <div class="space-y-1 text-sm text-neutral-400">
                <p><span class="text-neutral-300">200</span> — OK</p>
                <p><span class="text-neutral-300">404</span> — No encontrado</p>
              </div>
            </div>
          </div>
        </Card>

        <Card>
          <div class="mb-4 flex items-center justify-between">
            <div class="flex items-center gap-3">
              <div class="flex h-9 w-9 items-center justify-center rounded-lg bg-secondary/10">
                <svg class="h-5 w-5 text-secondary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                </svg>
              </div>
              <div>
                <h3 class="text-sm font-semibold text-white">Historial por Año</h3>
                <p class="text-xs text-neutral-500">Recupera el historial completo de un indicador en un año específico</p>
              </div>
            </div>
            <Badge variant="primary">GET</Badge>
          </div>
          <div class="rounded-lg bg-neutral-950 px-4 py-2.5 font-mono text-sm text-neutral-300">
            <span class="text-neutral-500">GET</span> https://api.mindicador.cl/api/&#123;tipo&#125;/&#123;año&#125;
          </div>
          <div class="mt-4 grid grid-cols-1 gap-3 sm:grid-cols-2">
            <div>
              <p class="mb-1 text-xs text-neutral-500">Parámetros</p>
              <div class="space-y-1 text-sm text-neutral-400">
                <p><span class="text-neutral-300">tipo</span> (string, requerido) — Código del indicador</p>
                <p><span class="text-neutral-300">año</span> (integer, requerido) — Año a consultar</p>
              </div>
            </div>
            <div>
              <p class="mb-1 text-xs text-neutral-500">Respuesta</p>
              <div class="space-y-1 text-sm text-neutral-400">
                <p><span class="text-neutral-300">200</span> — Array de objetos con fecha y valor</p>
              </div>
            </div>
          </div>
        </Card>

        <Card>
          <div class="mb-4 flex items-center justify-between">
            <div class="flex items-center gap-3">
              <div class="flex h-9 w-9 items-center justify-center rounded-lg bg-secondary/10">
                <svg class="h-5 w-5 text-secondary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
              </div>
              <div>
                <h3 class="text-sm font-semibold text-white">Listar Indicadores</h3>
                <p class="text-xs text-neutral-500">Obtiene la lista completa de indicadores disponibles</p>
              </div>
            </div>
            <Badge variant="primary">GET</Badge>
          </div>
          <div class="rounded-lg bg-neutral-950 px-4 py-2.5 font-mono text-sm text-neutral-300">
            <span class="text-neutral-500">GET</span> https://api.mindicador.cl/api
          </div>
          <div class="mt-4">
            <p class="mb-1 text-xs text-neutral-500">Respuesta</p>
            <p class="text-sm text-neutral-400">Objeto con todos los indicadores disponibles y sus valores actuales.</p>
          </div>
        </Card>

        <Card>
          <h3 class="mb-3 text-sm font-semibold text-white">Ejemplo de Respuesta</h3>
          <CodeBlock code={JSON.stringify({
            version: "1.7.0",
            autor: "mindicador.cl",
            fecha: "2026-06-25T19:00:00.000Z",
            uf: {
              codigo: "uf",
              nombre: "Unidad de Fomento (UF)",
              unidad_medida: "Pesos",
              fecha: "2026-06-25",
              valor: 38492.15
            },
            dolar: {
              codigo: "dolar",
              nombre: "Dólar observado",
              unidad_medida: "Pesos",
              fecha: "2026-06-25",
              valor: 956.32
            }
          }, null, 2)} />
          <p class="mt-4 text-xs text-neutral-500">* Datos de ejemplo con fines ilustrativos</p>
        </Card>
      </div>

      <div class="space-y-4">
        <Card>
          <h3 class="mb-3 text-sm font-semibold text-white">Indicadores Disponibles</h3>
          <div class="space-y-2 text-sm">
            {[
              { code: "uf", name: "Unidad de Fomento" },
              { code: "utm", name: "UTM" },
              { code: "dolar", name: "Dólar Observado" },
              { code: "euro", name: "Euro" },
              { code: "ipc", name: "IPC" },
              { code: "libra_cobre", name: "Libra de Cobre" },
              { code: "tasa_desempleo", name: "Tasa de Desempleo" },
              { code: "imacec", name: "IMACEC" },
            ].map((item) => (
              <div class="flex items-center justify-between rounded-lg bg-neutral-800/50 px-3 py-2">
                <span class="font-mono text-xs text-secondary">{item.code}</span>
                <span class="text-neutral-400">{item.name}</span>
              </div>
            ))}
          </div>
        </Card>

        <Card>
          <div class="flex items-center gap-3">
            <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-primary/10">
              <svg class="h-5 w-5 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
            </div>
            <div>
              <h3 class="text-sm font-semibold text-white">mindicador.cl</h3>
              <p class="text-xs text-neutral-500">API pública de indicadores chilenos</p>
            </div>
          </div>
          <p class="mt-3 text-xs leading-relaxed text-neutral-500">
            Los datos mostrados en esta aplicación son proporcionados por la API pública de mindicador.cl.
            Esta interfaz es únicamente una capa de presentación para visualizar y consultar dichos indicadores.
          </p>
          <div class="mt-4 rounded-lg bg-neutral-800/50 px-3 py-2 text-center text-xs text-neutral-500">
            <a href="https://mindicador.cl" target="_blank" rel="noopener noreferrer" class="text-secondary hover:text-secondary-light transition-colors">
              mindicador.cl
            </a>
            <span class="mx-2">·</span>
            Datos referenciales con fines informativos
          </div>
        </Card>
      </div>
    </div>
  </div>
</BaseLayout>
