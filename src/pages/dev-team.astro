---
import BaseLayout from '../layouts/BaseLayout.astro';
import TeamCard from '../components/ui/TeamCard.astro';

const team = [
  {
    name: "María González",
    role: "Tech Lead",
    description: "Arquitecta de software con más de 10 años de experiencia en sistemas financieros. Especialista en microservicios y cloud computing.",
    initials: "MG",
  },
  {
    name: "Carlos Muñoz",
    role: "Full Stack Developer",
    description: "Desarrollador full stack con enfoque en frontend moderno y experiencias de usuario intuitivas. Apasionado por Astro y React.",
    initials: "CM",
  },
  {
    name: "Ana Soto",
    role: "Backend Developer",
    description: "Ingeniera de software experta en APIs REST, bases de datos y arquitecturas escalables. Fanática de TypeScript y Node.js.",
    initials: "AS",
  },
  {
    name: "Pedro Ramírez",
    role: "UI/UX Designer",
    description: "Diseñador de interfaces con enfoque en systems design y experiencia de usuario. Creador de la identidad visual de PYME Finance.",
    initials: "PR",
  },
  {
    name: "Laura Vega",
    role: "Data Analyst",
    description: "Analista de datos especializada en visualización financiera e inteligencia de negocios. Transforma datos en decisiones estratégicas.",
    initials: "LV",
  },
];
---

<BaseLayout title="Dev Team" currentPath="/dev-team/">
  <div class="max-w-7xl animate-fade-in">
    <div class="mb-8">
      <h2 class="text-2xl font-bold text-white">Equipo de Desarrollo</h2>
      <p class="mt-1 text-sm text-neutral-400">Conoce al equipo detrás de PYME Finance</p>
    </div>

    <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-5">
      {team.map((member, i) => (
        <div class={`animate-slide-up ${i === 0 ? 'stagger-1' : i === 1 ? 'stagger-2' : i === 2 ? 'stagger-3' : i === 3 ? 'stagger-4' : 'stagger-5'}`}>
          <TeamCard
            name={member.name}
            role={member.role}
            description={member.description}
            avatarInitials={member.initials}
          />
        </div>
      ))}
    </div>

    <div class="mt-12 text-center">
      <div class="inline-flex items-center gap-2 rounded-full bg-neutral-800/40 px-4 py-2 text-xs text-neutral-500">
        <svg class="h-3.5 w-3.5 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197m13.5-9a2.25 2.25 0 11-4.5 0 2.25 2.25 0 014.5 0z" />
        </svg>
        5 miembros activos
      </div>
    </div>
  </div>
</BaseLayout>
