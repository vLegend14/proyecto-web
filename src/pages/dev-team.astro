---
import BaseLayout from '../layouts/BaseLayout.astro';
import TeamCard from '../components/ui/TeamCard.astro';

const team = [
  { name: "María González", role: "Tech Lead", description: "Arquitecta de software con más de 10 años en sistemas financieros. Especialista en microservicios y cloud computing.", initials: "MG" },
  { name: "Carlos Muñoz", role: "Full Stack Developer", description: "Desarrollador full stack con enfoque en frontend moderno. Apasionado por Astro y React.", initials: "CM" },
  { name: "Ana Soto", role: "Backend Developer", description: "Ingeniera experta en APIs REST, bases de datos y TypeScript.", initials: "AS" },
  { name: "Pedro Ramírez", role: "UI/UX Designer", description: "Diseñador de interfaces con enfoque in systems design. Creador de la identidad visual de PYME Finance.", initials: "PR" },
  { name: "Laura Vega", role: "Data Analyst", description: "Analista especializada en visualización financiera. Transforma datos en decisiones estratégicas.", initials: "LV" },
];
---

<BaseLayout title="Dev Team" currentPath="/dev-team/">
  <div class="mx-auto max-w-6xl">
    <div class="mb-7">
      <h2 class="text-xl font-bold tracking-tight text-white sm:text-2xl">Equipo</h2>
      <p class="mt-0.5 text-sm text-slate-500">Conoce al equipo detrás de PYME Finance</p>
    </div>

    <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-5">
      {team.map((member, i) => (
        <div style={`animation: slideUp 0.4s ease-out ${i * 0.08}s both`}>
          <TeamCard
            name={member.name}
            role={member.role}
            description={member.description}
            avatarInitials={member.initials}
          />
        </div>
      ))}
    </div>

    <div class="mt-10 text-center">
      <div class="inline-flex items-center gap-2 rounded-full bg-slate-800/20 px-3.5 py-1.5">
        <span class="flex h-2 w-2 rounded-full bg-emerald-500" />
        <span class="text-[11px] text-slate-500">5 miembros activos</span>
      </div>
    </div>
  </div>
</BaseLayout>
