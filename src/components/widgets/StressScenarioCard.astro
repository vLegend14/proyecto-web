---
import Card from "../ui/Card.astro";
import Badge from "../ui/Badge.astro";

export interface Props {
  title: string;
  value: string;
  change: string;
  description: string;
  variant: "optimistic" | "conservative" | "risk";
  class?: string;
}

const { title, value, change, description, variant, class: className = "" } = Astro.props;

const config = {
  optimistic: {
    badge: "Optimista",
    badgeVariant: "up" as const,
    icon: "M13 7h8m0 0v8m0-8l-8 8-4-4-6 6",
    accent: "text-emerald-400",
    bg: "bg-emerald-500/5",
    border: "border-emerald-500/20",
    gradient: "from-emerald-500/10 to-transparent",
  },
  conservative: {
    badge: "Conservador",
    badgeVariant: "neutral" as const,
    icon: "M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z",
    accent: "text-blue-400",
    bg: "bg-blue-500/5",
    border: "border-blue-500/20",
    gradient: "from-blue-500/10 to-transparent",
  },
  risk: {
    badge: "Riesgo",
    badgeVariant: "down" as const,
    icon: "M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L4.082 16.5c-.77.833.192 2.5 1.732 2.5z",
    accent: "text-red-400",
    bg: "bg-red-500/5",
    border: "border-red-500/20",
    gradient: "from-red-500/10 to-transparent",
  },
};

const cfg = config[variant];
---

<Card class="bg-gradient-to-br {cfg.gradient} {cfg.bg} {cfg.border} border {className}">
  <div class="flex items-start justify-between">
    <Badge variant={cfg.badgeVariant}>{cfg.badge}</Badge>
    <svg class="h-5 w-5 {cfg.accent}" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
      <path stroke-linecap="round" stroke-linejoin="round" d={cfg.icon} />
    </svg>
  </div>
  <p class="mt-4 text-sm text-neutral-400">{title}</p>
  <p class="mt-1 text-2xl font-bold text-white tabular-nums">{value}</p>
  <p class="mt-1 text-sm {cfg.accent} font-medium">{change}</p>
  <div class="mt-4 h-px bg-gradient-to-r {variant === 'optimistic' ? 'from-emerald-500/30 to-transparent' : variant === 'conservative' ? 'from-blue-500/30 to-transparent' : 'from-red-500/30 to-transparent'}" />
  <p class="mt-4 text-xs leading-relaxed text-neutral-500">{description}</p>
</Card>
