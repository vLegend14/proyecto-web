---
export interface Props {
  variant?: "up" | "down" | "neutral" | "primary" | "secondary" | "danger";
  class?: string;
}

const { variant = "neutral", class: className = "" } = Astro.props;

const variants = {
  up: "bg-emerald-500/8 text-emerald-400 border-emerald-500/15",
  down: "bg-red-500/8 text-red-400 border-red-500/15",
  neutral: "bg-slate-500/8 text-slate-400 border-slate-500/15",
  primary: "bg-emerald-500/8 text-emerald-400 border-emerald-500/15",
  secondary: "bg-blue-500/8 text-blue-400 border-blue-500/15",
  danger: "bg-red-500/8 text-red-400 border-red-500/15",
};
---

<span class="inline-flex items-center gap-1 rounded-full border px-2 py-0.5 text-[11px] font-medium {variants[variant]} {className}">
  <slot />
</span>
