---
import { navItems } from "../../data/navigation";

export interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;

const pathMap: Record<string, string> = {};
for (const item of navItems) {
  pathMap[item.href] = item.label;
}

const crumbs: { href: string; label: string }[] = [];
const parts = currentPath.split("/").filter(Boolean);

let acc = "";
for (const part of parts) {
  acc += "/" + part + "/";
  const label = pathMap[acc] || part.charAt(0).toUpperCase() + part.slice(1).replace(/-/g, " ");
  crumbs.push({ href: acc, label });
}
---

<nav aria-label="Breadcrumb" class="hidden items-center gap-1.5 text-[11px] sm:flex">
  <a href="/" class="text-slate-600 transition-colors hover:text-slate-400">
    <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
      <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 12l8.954-8.955c.44-.439 1.152-.439 1.591 0L21.75 12M4.5 9.75v10.125c0 .621.504 1.125 1.125 1.125H9.75v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21h4.125c.621 0 1.125-.504 1.125-1.125V9.75M8.25 21h5.25" />
    </svg>
  </a>
  {crumbs.map((crumb, i) => (
    <span class="flex items-center gap-1.5">
      <svg class="h-3 w-3 text-slate-700" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" />
      </svg>
      {i === crumbs.length - 1 ? (
        <span class="text-slate-400">{crumb.label}</span>
      ) : (
        <a href={crumb.href} class="text-slate-600 transition-colors hover:text-slate-400">
          {crumb.label}
        </a>
      )}
    </span>
  ))}
</nav>
