---
export interface Props {
  headers: string[];
  rows: string[][];
  class?: string;
  loading?: boolean;
  empty?: boolean;
  error?: boolean;
  sortable?: boolean;
  sortKey?: number;
  sortDir?: "asc" | "desc";
}

const { headers, rows, class: className = "", loading = false, empty = false, error = false, sortable = false, sortKey, sortDir } = Astro.props;
---

<div class="overflow-hidden rounded-xl border border-slate-800/60 shadow-sm shadow-black/20 {className}">
  <div class="overflow-x-auto">
    <table class="min-w-full text-sm">
      <thead>
        <tr class="border-b border-slate-800/60 bg-slate-900/60">
          {headers.map((header, i) => (
            <th class="whitespace-nowrap px-4 py-3 text-left text-[10px] font-semibold uppercase tracking-widest text-slate-500 {i === 0 ? 'pl-5' : ''} {sortable ? 'cursor-pointer select-none transition-colors hover:text-slate-400 active:scale-95' : ''}">
              <span class="inline-flex items-center gap-1">
                {header}
                {sortable && (
                  <span class="inline-flex flex-col leading-none">
                    <svg class={`h-2 w-2 -mb-0.5 ${sortKey === i && sortDir === "asc" ? "text-emerald-400" : "text-slate-700"}`} fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 15.75l7.5-7.5 7.5 7.5" />
                    </svg>
                    <svg class={`h-2 w-2 ${sortKey === i && sortDir === "desc" ? "text-emerald-400" : "text-slate-700"}`} fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
                    </svg>
                  </span>
                )}
              </span>
            </th>
          ))}
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-800/30">
        {loading &&
          Array.from({ length: 5 }).map((_, ri) => (
            <tr class={ri % 2 === 1 ? "bg-slate-800/10" : ""}>
              {headers.map((_, i) => (
                <td class="px-4 py-3 {i === 0 ? 'pl-5' : ''}">
                  <div class={`h-3.5 rounded skeleton-shimmer ${i === 0 ? "w-32" : i === headers.length - 1 ? "w-20" : "w-24"}`} />
                </td>
              ))}
            </tr>
          ))}
        {empty && !loading &&
          (
            <tr>
              <td colspan={headers.length} class="px-4 py-16 text-center">
                <div class="flex flex-col items-center gap-2.5">
                  <div class="flex h-10 w-10 items-center justify-center rounded-full bg-slate-800/50">
                    <svg class="h-5 w-5 text-slate-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M20.25 7.5l-.625 10.632a2.25 2.25 0 01-2.247 2.118H6.622a2.25 2.25 0 01-2.247-2.118L3.75 7.5m6 4.125l2.25 2.25m0 0l2.25 2.25M12 11.625l2.25-2.25M12 11.625l-2.25 2.25M3.375 7.5h17.25c.621 0 1.125-.504 1.125-1.125v-1.5c0-.621-.504-1.125-1.125-1.125H3.375c-.621 0-1.125.504-1.125 1.125v1.5c0 .621.504 1.125 1.125 1.125z" />
                    </svg>
                  </div>
                  <div>
                    <p class="text-sm font-medium text-slate-400">Sin datos</p>
                    <p class="mt-0.5 text-xs text-slate-600">No se encontraron registros.</p>
                  </div>
                </div>
              </td>
            </tr>
          )}
        {error && !loading &&
          (
            <tr>
              <td colspan={headers.length} class="px-4 py-16 text-center">
                <div class="flex flex-col items-center gap-2.5">
                  <div class="flex h-10 w-10 items-center justify-center rounded-full bg-red-500/8">
                    <svg class="h-5 w-5 text-red-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126zM12 15.75h.007v.008H12v-.008z" />
                    </svg>
                  </div>
                  <div>
                    <p class="text-sm font-medium text-slate-400">Error de carga</p>
                    <p class="mt-0.5 text-xs text-slate-600">No se pudo obtener la información.</p>
                  </div>
                </div>
              </td>
            </tr>
          )}
        {!loading && !empty && !error && rows.map((row, ri) => (
          <tr class="transition-colors hover:bg-slate-800/20 {ri % 2 === 1 ? 'bg-slate-800/10' : ''}">
            {row.map((cell, i) => (
              <td class="whitespace-nowrap px-4 py-2.5 text-slate-300 {i === 0 ? 'pl-5 font-medium text-slate-200' : ''}">
                {cell}
              </td>
            ))}
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  {!loading && !empty && !error && rows.length > 0 && (
    <div class="flex items-center justify-between border-t border-slate-800/30 bg-slate-900/30 px-4 py-2.5">
      <span class="text-[11px] text-slate-600">{rows.length} resultados</span>
      <div class="flex items-center gap-1">
        <button class="flex h-7 w-7 items-center justify-center rounded-md text-slate-600 transition-colors hover:bg-slate-800/40 hover:text-slate-400 active:scale-95 disabled:cursor-not-allowed disabled:opacity-40" disabled>&lsaquo;</button>
        <button class="flex h-7 w-7 items-center justify-center rounded-md bg-emerald-500/10 text-[11px] font-medium text-emerald-400 active:scale-95">1</button>
        <button class="flex h-7 w-7 items-center justify-center rounded-md text-slate-600 transition-colors hover:bg-slate-800/40 hover:text-slate-400 active:scale-95">2</button>
        <button class="flex h-7 w-7 items-center justify-center rounded-md text-slate-600 transition-colors hover:bg-slate-800/40 hover:text-slate-400 active:scale-95">3</button>
        <button class="flex h-7 w-7 items-center justify-center rounded-md text-slate-600 transition-colors hover:bg-slate-800/40 hover:text-slate-400 active:scale-95">&rsaquo;</button>
      </div>
    </div>
  )}
</div>
