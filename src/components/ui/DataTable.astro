---
export interface Props {
  headers: string[];
  rows: string[][];
  class?: string;
  empty?: boolean;
  error?: boolean;
}

const { headers, rows, class: className = "", empty = false, error = false } = Astro.props;
---

<div class="overflow-hidden rounded-xl border border-neutral-800 {className}">
  <div class="overflow-x-auto">
    <table class="min-w-full divide-y divide-neutral-800 text-sm">
      <thead class="bg-neutral-900/90">
        <tr>
          {headers.map((header, i) => (
            <th class="sticky top-0 whitespace-nowrap px-4 py-3.5 text-left text-xs font-semibold uppercase tracking-wider text-neutral-400 {i === 0 ? 'pl-5' : ''}">
              {header}
            </th>
          ))}
        </tr>
      </thead>
      <tbody class="divide-y divide-neutral-800/60">
        {empty &&
          (
            <tr>
              <td colspan={headers.length} class="px-4 py-20 text-center text-neutral-500">
                <div class="flex flex-col items-center gap-3">
                  <div class="flex h-12 w-12 items-center justify-center rounded-full bg-neutral-800">
                    <svg class="h-6 w-6 text-neutral-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M20 13V6a2 2 0 00-2-2H6a2 2 0 00-2 2v7m16 0v5a2 2 0 01-2 2H6a2 2 0 01-2-2v-5m16 0h-2.586a1 1 0 00-.707.293l-2.414 2.414a1 1 0 01-.707.293h-3.172a1 1 0 01-.707-.293l-2.414-2.414A1 1 0 006.586 13H4" />
                    </svg>
                  </div>
                  <div>
                    <p class="text-sm font-medium text-neutral-400">Sin datos disponibles</p>
                    <p class="mt-0.5 text-xs text-neutral-600">No se encontraron registros para los filtros seleccionados.</p>
                  </div>
                </div>
              </td>
            </tr>
          )}
        {error &&
          (
            <tr>
              <td colspan={headers.length} class="px-4 py-20 text-center text-neutral-500">
                <div class="flex flex-col items-center gap-3">
                  <div class="flex h-12 w-12 items-center justify-center rounded-full bg-red-500/10">
                    <svg class="h-6 w-6 text-red-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126zM12 15.75h.007v.008H12v-.008z" />
                    </svg>
                  </div>
                  <div>
                    <p class="text-sm font-medium text-neutral-400">Error al cargar datos</p>
                    <p class="mt-0.5 text-xs text-neutral-600">No fue posible obtener la información. Intenta nuevamente.</p>
                  </div>
                </div>
              </td>
            </tr>
          )}
        {!empty && !error && rows.map((row, ri) => (
          <tr class="transition-colors hover:bg-neutral-800/40 {ri % 2 === 1 ? 'bg-neutral-800/20' : ''}">
            {row.map((cell, i) => (
              <td class="whitespace-nowrap px-4 py-3 text-neutral-300 {i === 0 ? 'pl-5 font-medium text-white' : ''}">
                {cell}
              </td>
            ))}
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  {!empty && !error && rows.length > 0 && (
    <div class="flex items-center justify-between border-t border-neutral-800/60 bg-neutral-900/50 px-4 py-3 text-xs text-neutral-500">
      <span>Mostrando {rows.length} resultados</span>
      <div class="flex items-center gap-2">
        <span class="flex h-7 w-7 items-center justify-center rounded border border-neutral-700 bg-neutral-800 text-neutral-400">&lsaquo;</span>
        <span class="flex h-7 w-7 items-center justify-center rounded border border-primary/30 bg-primary/10 text-xs font-medium text-primary">1</span>
        <span class="flex h-7 w-7 items-center justify-center rounded border border-neutral-700 text-neutral-500">2</span>
        <span class="flex h-7 w-7 items-center justify-center rounded border border-neutral-700 text-neutral-500">3</span>
        <span class="flex h-7 w-7 items-center justify-center rounded border border-neutral-700 bg-neutral-800 text-neutral-400">&rsaquo;</span>
      </div>
    </div>
  )}
</div>
