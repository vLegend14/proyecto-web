---
export interface Props {
  code: string;
  class?: string;
  filename?: string;
}

const { code, class: className = "", filename = "response.json" } = Astro.props;
---

<div class="overflow-hidden rounded-xl border border-slate-800/60 shadow-sm shadow-black/20 {className}">
  <div class="flex items-center justify-between border-b border-slate-800/60 bg-slate-900/70 px-4 py-2.5">
    <div class="flex items-center gap-1.5">
      <span class="h-2 w-2 rounded-full bg-red-500/60" />
      <span class="h-2 w-2 rounded-full bg-amber-500/60" />
      <span class="h-2 w-2 rounded-full bg-emerald-500/60" />
    </div>
    <div class="flex items-center gap-2">
      <span class="text-[11px] text-slate-500">{filename}</span>
      <button class="flex h-6 w-6 items-center justify-center rounded text-slate-600 transition-colors hover:bg-slate-800/40 hover:text-slate-400">
        <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15.666 3.888A2.25 2.25 0 0013.5 2.25h-3c-1.03 0-1.9.693-2.166 1.638m7.332 0c.055.194.084.4.084.612v0a.75.75 0 01-.75.75H9a.75.75 0 01-.75-.75v0c0-.212.03-.418.084-.612m7.332 0c.646.049 1.288.11 1.927.184 1.1.128 1.907 1.077 1.907 2.185V19.5a2.25 2.25 0 01-2.25 2.25H6.75A2.25 2.25 0 014.5 19.5V6.257c0-1.108.806-2.057 1.907-2.185a48.208 48.208 0 011.927-.184" />
        </svg>
      </button>
    </div>
  </div>
  <pre class="overflow-x-auto bg-slate-950/60 p-6 text-[13px] leading-relaxed"><code class="text-slate-300">{code}</code></pre>
</div>
