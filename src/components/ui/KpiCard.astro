---
import Card from "./Card.astro";
import Badge from "./Badge.astro";

export interface Props {
  label: string;
  value: string;
  time: string;
  trend: "up" | "down";
  trendLabel: string;
  icon: "uf" | "utm" | "usd" | "eur";
  class?: string;
  stagger?: string;
}

const { label, value, time, trend, trendLabel, icon, class: className = "", stagger = "" } = Astro.props;

const icons = {
  uf: "M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8zm-1-13h2v6h-2zm0 8h2v2h-2z",
  utm: "M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm0 16H5V5h14v14zm-7-3h2v2h-2zm-4-4h2v2H8zm8 0h2v2h-2zm-4-4h2v2h-2zm4-4h2v2h-2z",
  usd: "M11.5 1.5c-5.5 0-10 4.5-10 10s4.5 10 10 10 10-4.5 10-10-4.5-10-10-10zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8zm.5-13v1c-1.66 0-3 1.34-3 3s1.34 3 3 3v1c0 .55-.45 1-1 1h-.5c-.55 0-1-.45-1-1h-2c0 1.66 1.34 3 3 3v1h2v-1c1.66 0 3-1.34 3-3s-1.34-3-3-3v-1c0-.55.45-1 1-1h.5c.55 0 1 .45 1 1h2c0-1.66-1.34-3-3-3v-1h-2z",
  eur: "M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8zm-3-7h6v2H9zm5-4H9v2h5z",
};

const sparklineData = trend === "up" ? "M0,16 Q8,12 16,14 Q24,10 32,11 Q40,6 48,8 Q56,3 64,4" : "M0,4 Q8,8 16,6 Q24,10 32,9 Q40,14 48,12 Q56,17 64,16";
const sparkColor = trend === "up" ? "rgb(52,211,153)" : "rgb(248,113,113)";
---

<Card class="animate-fade-in {stagger} {className}">
  <div class="flex items-start justify-between">
    <div class="flex h-11 w-11 items-center justify-center rounded-xl bg-gradient-to-br from-primary/15 to-primary/5 ring-1 ring-primary/10">
      <svg class="h-5 w-5 text-primary" fill="currentColor" viewBox="0 0 24 24">
        <path d={icons[icon]} />
      </svg>
    </div>
    <Badge variant={trend}>
      <svg class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        {trend === "up"
          ? <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 10l7-7m0 0l7 7m-7-7v18" />
          : <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
        }
      </svg>
      {trendLabel}
    </Badge>
  </div>
  <div class="mt-3 flex items-end justify-between">
    <div>
      <p class="text-xs font-medium tracking-wide text-neutral-500 uppercase">{label}</p>
      <p class="mt-1 text-2xl font-bold text-white tabular-nums">{value}</p>
      <p class="mt-1.5 text-xs text-neutral-500">Actualizado {time}</p>
    </div>
    <svg class="h-10 w-20 flex-shrink-0" viewBox="0 0 64 20" fill="none">
      <path d={sparklineData} stroke={sparkColor} stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" fill="none" />
    </svg>
  </div>
</Card>
