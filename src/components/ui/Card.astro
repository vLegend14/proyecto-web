---
export interface Props {
  class?: string;
  padding?: boolean;
}

const { class: className = "", padding = true } = Astro.props;
---

<div class="rounded-xl border border-neutral-800 bg-neutral-900/50 backdrop-blur-sm shadow-lg shadow-black/20 {padding ? 'p-5' : ''} {className}">
  <slot />
</div>
