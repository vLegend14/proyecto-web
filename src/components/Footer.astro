---
const year = new Date().getFullYear();
---

<footer class="border-t border-neutral-800/60 bg-neutral-950/30">
  <div class="mx-auto max-w-7xl px-4 py-5">
    <div class="flex flex-col items-center justify-between gap-2 sm:flex-row">
      <p class="text-xs text-neutral-600">
        PYME Finance &copy; {year}
      </p>
      <div class="flex items-center gap-4 text-xs text-neutral-600">
        <span>Hecho con Astro + React + Tailwind</span>
        <span class="hidden sm:inline">&middot;</span>
        <span class="hidden sm:inline">Datos referenciales &middot; mindicador.cl</span>
      </div>
    </div>
  </div>
</footer>
