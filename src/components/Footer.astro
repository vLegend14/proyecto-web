---
const year = new Date().getFullYear();
---

<footer class="border-t border-slate-800/40 bg-slate-900/20">
  <div class="mx-auto max-w-6xl px-6 py-6">
    <div class="flex flex-col items-center justify-between gap-2 sm:flex-row">
      <p class="text-[11px] text-slate-600">
        PYME Finance &copy; {year} <span class="hidden sm:inline">&middot; v1.0.0</span>
      </p>
      <div class="flex items-center gap-3 text-[11px] text-slate-600">
        <a href="#" class="transition-colors hover:text-slate-400">Términos</a>
        <span class="hidden sm:inline">&middot;</span>
        <a href="#" class="transition-colors hover:text-slate-400">Privacidad</a>
        <span class="hidden sm:inline">&middot;</span>
        <span>Datos: mindicador.cl</span>
      </div>
      <span class="text-[11px] text-slate-600">soporte@pymefinance.cl</span>
    </div>
  </div>
</footer>
