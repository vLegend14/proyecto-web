---
const year = new Date().getFullYear();
---

<footer class="border-t border-slate-800/40 bg-slate-900/20">
  <div class="mx-auto max-w-6xl px-4 py-4">
    <div class="flex flex-col items-center justify-between gap-2 sm:flex-row">
      <p class="text-[11px] text-slate-600">
        PYME Finance &copy; {year} <span class="hidden sm:inline">&middot; v1.0.0</span>
      </p>
      <div class="flex items-center gap-3 text-[11px] text-slate-600">
        <a href="#" class="transition-colors hover:text-slate-400">Términos</a>
        <span class="hidden sm:inline">&middot;</span>
        <a href="#" class="transition-colors hover:text-slate-400">Privacidad</a>
        <span class="hidden sm:inline">&middot;</span>
        <span>Datos: mindicador.cl</span>
      </div>
      <div class="flex items-center gap-2 text-[11px] text-slate-600">
        <svg class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" />
        </svg>
        <span>soporte@pymefinance.cl</span>
      </div>
    </div>
  </div>
</footer>
